{
  "name": "cv-portfolio-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fsd:check": "steiger ./src",
    "check": "npm run lint && npm run format:check && npm run fsd:check && npm run test && npm run build",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "i18next": "^25.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.3.2"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.1.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "steiger": "^0.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.14"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
